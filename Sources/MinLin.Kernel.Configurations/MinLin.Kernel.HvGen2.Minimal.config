##
## PROJECT:    MinLin
## FILE:       MinLin.Kernel.HvGen2.Minimal.config
## PURPOSE:    The minimal Linux kernel configuration for Hyper-V Generation 2
##             Virtual Machines
##
## LICENSE:    The MIT License
##
## MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
##

##
## Generate the complete kernel configuration with:
##
##   make \
##     ARCH=x86 \
##     KCONFIG_ALLCONFIG=MinLin.Kernel.HvGen2.Minimal.config \
##     allnoconfig
##

##
## Configuration Identity
##
CONFIG_LOCALVERSION="-MinLin.Kernel.HvGen2.Minimal"

##
## Base Kernel Configuration
##
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MULTIUSER=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_MEMORY_HOTPLUG=y

##
## Virtualized x86 Platform Support
##
CONFIG_HYPERVISOR_GUEST=y
CONFIG_X86_X2APIC=y

##
## ACPI and UEFI Support
##
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

##
## Loadable Kernel Module Support
##
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

##
## Initial RAM File System Support
##
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

##
## Executable Format Support
##
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

##
## Userspace ABI Support
##
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y

##
## Device Node and Pseudo File System Support
##
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_SYSCTL=y

##
## Userspace I/O Support
##
CONFIG_UIO=y

##
## PCI and IOMMU Support
##
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_IOMMU_SUPPORT=y

##
## Network Support
##
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_VSOCKETS=y
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# Kept for compatibility with Linux 3.13 through 5.16.
# Linux 5.17 and later no longer require this standalone option.
CONFIG_NFT_COUNTER=y
CONFIG_NFT_REJECT=y

##
## Input Support
##
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y

##
## Native Language Support
##
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

##
## Kernel and Userspace Connector Support
##
CONFIG_CONNECTOR=y

##
## Microsoft Hyper-V Guest Support
##
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_DRM_HYPERV=y
CONFIG_PCI_HYPERV=y
CONFIG_PCI_HYPERV_INTERFACE=y
CONFIG_HYPERV_IOMMU=y
CONFIG_UIO_HV_GENERIC=y

##
## Kernel-based Virtual Machine Support
##
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_IOAPIC=y

##
## Block Device and SCSI Support
##
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y

##
## Partition Table Support
##
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

##
## Disk File System Support
##
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y

##
## Optical Disc File System Support
##
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y

## Network File System Support
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y

##
## Console and Framebuffer Support
##
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_UNIX98_PTYS=y
