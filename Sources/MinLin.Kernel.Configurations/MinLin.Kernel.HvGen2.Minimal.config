## MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
## 

##
## Generate the complete kernel configuration with:
##
##   make \
##     ARCH=x86 \
##     KCONFIG_ALLCONFIG=MinLin.Kernel.HvGen2.Minimal.config \
##     allnoconfig
##

##
## Configuration Identity
##
CONFIG_LOCALVERSION="-MinLin.Kernel.HvGen2.Minimal"

##
## Base Kernel Configuration
##
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
