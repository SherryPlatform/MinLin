<?xml version="1.0" encoding="utf-8"?>
<!--
  PROJECT:   MinLin
  FILE:      Mile.HyperV.props
  PURPOSE:   MSBuild Properties for referencing Mile.HyperV library

  LICENSE:   The MIT License

  MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludePath>$(MSBuildThisFileDirectory);$(IncludePath)</IncludePath>
    <AdditionalSourcesToCopyMapping>$(MSBuildThisFileDirectory):=$(RemoteRootDir)/Mile.HyperV;$(AdditionalSourcesToCopyMapping)</AdditionalSourcesToCopyMapping>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_M_AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='ARM64'">_M_ARM64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
