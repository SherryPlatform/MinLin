<?xml version="1.0" encoding="utf-8"?>
<!--
  PROJECT:   MinLin
  FILE:      Mile.Mobility.props
  PURPOSE:   MSBuild Properties for referencing Mile.Mobility library

  LICENSE:   The MIT License

  MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludePath>$(MSBuildThisFileDirectory);$(IncludePath)</IncludePath>
    <AdditionalSourcesToCopyMapping>$(MSBuildThisFileDirectory):=$(RemoteRootDir)/Mile.Mobility;$(AdditionalSourcesToCopyMapping)</AdditionalSourcesToCopyMapping>
  </PropertyGroup>
  <Target Name="MileMobilityibraryBuildSource" BeforeTargets="BeforeClCompile">
    <ItemGroup>
      <ClCompile Include="$(MSBuildThisFileDirectory)Mile.Mobility.Utilities.FixedInteger.c" />
      <ClCompile Include="$(MSBuildThisFileDirectory)Mile.Mobility.Utilities.MemoryAccess.c" />
    </ItemGroup>
  </Target>
</Project>
